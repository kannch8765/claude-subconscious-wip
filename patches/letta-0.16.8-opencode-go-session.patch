+def with_opencode_go_session_header(request_data: dict, llm_config: LLMConfig, session_id: str | None) -> dict:
+    """Attach OpenCode Go's stable per-conversation routing header to one request.
+
+    The header is request-scoped rather than stored on the shared LLM client so
+    concurrent Letta conversations cannot overwrite each other's session ID.
+    """
+    endpoint = (llm_config.model_endpoint or "").rstrip("/")
+    if not session_id or not endpoint.startswith("https://opencode.ai/zen/go"):
+        return request_data
+    updated = dict(request_data)
+    headers = dict(updated.get("extra_headers") or {})
+    headers["x-opencode-session"] = session_id
+    updated["extra_headers"] = headers
+    return updated
+
