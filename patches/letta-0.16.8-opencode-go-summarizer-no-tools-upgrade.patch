+def without_opencode_go_empty_tool_controls(request_data: dict, llm_config: LLMConfig) -> dict:
+    """Drop empty tool controls that OpenCode Go rejects on no-tools requests.
+
+    Letta's OpenAI request model serializes explicitly supplied ``None`` fields
+    even with ``exclude_unset=True``. OpenCode Go treats the presence of
+    ``tool_choice`` as invalid unless real tools are also supplied. Keep this
+    normalization request-scoped and endpoint-specific.
+    """
+    endpoint = (llm_config.model_endpoint or "").rstrip("/")
+    if not endpoint.startswith("https://opencode.ai/zen/go") or request_data.get("tools"):
+        return request_data
+    updated = dict(request_data)
+    updated.pop("tools", None)
+    updated.pop("tool_choice", None)
+    updated.pop("parallel_tool_calls", None)
+    return updated
+
