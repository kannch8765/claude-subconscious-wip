# 7) Keep the older prompt-only regression fixtures canonical on runtime fields so
# they continue to isolate prompt drift, while updating the broadened error boundary.
p = ROOT / 'scripts/agent_prompt_reconciliation.test.ts'
text = p.read_text()
text = text.replace(
"        llm_config: { handle: 'openai/gpt-5.2', model: 'gpt-5.2', provider_name: 'openai' },",
"        model: 'opencode-deepseek/deepseek-v4-flash',\n        embedding: 'local-fastembed/paraphrase-multilingual-minilm-l12-v2-padded768',\n        context_window_limit: 400000,\n        model_settings: { parallel_tool_calls: true },\n        llm_config: { handle: 'opencode-deepseek/deepseek-v4-flash', model: 'deepseek-v4-flash', provider_name: 'opencode-deepseek', context_window: 400000, parallel_tool_calls: true },",
1,
)
text = text.replace(
"rejects.toThrow('Failed to reconcile managed Subconscious system prompt')",
"rejects.toThrow('Failed to reconcile managed Subconscious runtime configuration')",
1,
)
p.write_text(text)
